<Window x:Class="ClothingStore.WPF.PopUpWindows.CreateBillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="720" Width="1200"
        WindowStyle="None"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent">
    <Border Background="#eff2f7" CornerRadius="30" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="25,10,25,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="400"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>


                </Grid.RowDefinitions>
                <TextBlock Text="Bill Details" Grid.Row="0" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0" HorizontalAlignment="Left" Foreground="#121518"/>
                <DataGrid x:Name="dgBillItems" Grid.Row="1" AutoGenerateColumns="False" >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Product.Name}" Width="*"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" />
                        <DataGridTextColumn Header="Unit Price" Binding="{Binding Product.Price}" />
                        <DataGridTemplateColumn Header="Operations">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="DeleteButton_Click" Style="{StaticResource gridRemoveButton}">
                                        <Icon:PackIconMaterial Kind="Deleteoutline" Style="{StaticResource gridButtonIcon}"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!--<StackPanel Grid.Row="3">
                    <Label x:Name="label1" Margin="2,2,2,2" Content="Choose a Customer" Grid.Column="0"
                     Grid.Row="1" Grid.ColumnSpan="2"/>
                    <ComboBox x:Name="cboCustomer"/>
                </StackPanel>-->
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="price" Text="Total Price: " FontSize="20" FontWeight="SemiBold" Margin="0 20 0 0" HorizontalAlignment="Left" Foreground="#121518"/>
                </StackPanel>
                <Button Style="{StaticResource addButton}" Click="PurchaseButton_Click" Grid.Row="4">
                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Width="11" Height="11" Margin="0 1 8 0"/>
                        <TextBlock Text="Purchase"/>
                    </StackPanel>
                </Button>
            </Grid>
            


            <Grid Grid.Column="1" Margin="25,10,25,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid Width="300" HorizontalAlignment="Left">
                    <TextBlock Margin="20 0" VerticalAlignment="Center" Foreground="#b0b9c6" IsHitTestVisible="False" Panel.ZIndex="1" Text=""
                    Visibility="Visible"/>
                    <TextBox x:Name="txtSearch" Style="{StaticResource textboxSearch}"/>
                    <Button Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 15 0" BorderThickness="0" 
                        Click="Search_Clicked">
                        <Button.Background>
                            <SolidColorBrush Color="Transparent"/>
                        </Button.Background>
                        <Button.Content>
                            <Icon:PackIconMaterial Kind="Magnify" Width="15" Height="15" Foreground="#60b9c6"/>
                        </Button.Content>
                    </Button>
                </Grid>
                <TextBlock Text="Products" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0" HorizontalAlignment="Left" Foreground="#121518"/>
                <Separator Grid.Row="3" Margin="0 -1 0 10" Height="1" Background="#dae2ea"/>
                <Grid Width="200" HorizontalAlignment="Right" Grid.Row="4"/>
                <DataGrid x:Name="dgProducts" RowHeaderStyle="{DynamicResource DataGridRowHeaderStyle1}" RowStyle="{DynamicResource DataGridRowStyle1}" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" Style="{DynamicResource DataGridStyle1}" CellStyle="{DynamicResource DataGridCellStyle1}" Margin="10,10,0,10" Grid.Row="5">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn CanUserResize="False" Width="auto">
                            <DataGridCheckBoxColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox/>
                                </DataTemplate>
                            </DataGridCheckBoxColumn.HeaderTemplate>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="Id" Width="auto" IsReadOnly="True" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Name" Width="*" IsReadOnly="True" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Price" Width="auto" IsReadOnly="True" Binding="{Binding Price}"/>
                        <DataGridTextColumn Header="Quantity" Width="auto" IsReadOnly="True" Binding="{Binding Quantity}"/>
                        <DataGridTextColumn Header="Category" Width="auto" IsReadOnly="True" Binding="{Binding Category}"/>
                        <DataGridTemplateColumn Header="Operations" IsReadOnly="True" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="AddButton_Click" Style="{StaticResource gridEditButton}" Content="Add">
                                            
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>



                    </DataGrid.Columns>
                </DataGrid>

            </Grid>


        </Grid>




    </Border>
</Window>
