<Window x:Class="ClothingStore.WPF.PopUpWindows.AddCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClothingStore.WPF.PopUpWindows"
        mc:Ignorable="d"
        Title="AddCustomerWindow" Height="300" Width="400">
    <Grid>
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0099FF" Offset="0"/>
                    <GradientStop Color="#FF347BDA" Offset="0.794"/>
                    <GradientStop Color="#FF60B1E7" Offset="1"/>
                    <GradientStop Color="#FF596FDD" Offset="0.309"/>
                    <GradientStop Color="#FF472FDE" Offset="0.484"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="119.415"/>
                <ColumnDefinition Width="30.585"/>
                <ColumnDefinition Width="47*"/>
                <ColumnDefinition Width="513*"/>
            </Grid.ColumnDefinitions>
            <Label x:Name="label" Content="Add Customer" Grid.Row="0"
   FontSize="36" HorizontalAlignment="Left" Width="466" Grid.ColumnSpan="3" Margin="25,0,0,0" Grid.Column="1"/>


            <Label x:Name="label2" Margin="2,2,2,2" Grid.Column="0" Grid.Row="2" Content="Customer Name"
   Grid.ColumnSpan="2"/>
            <TextBox x:Name="txtName" Margin="4,4,4,4" Grid.Column="2" Grid.Row="2" Text=""
     TextWrapping="Wrap" Grid.ColumnSpan="2"/>
            <Label x:Name="label8" Margin="2,2,2,2" Content="Phone" Grid.Column="0" Grid.Row="3"
   Grid.ColumnSpan="2"/>
            <TextBox x:Name="txtPhone" Margin="4,4,4,4" Grid.Column="2" Grid.Row="3" Text=""
     TextWrapping="Wrap" Grid.ColumnSpan="2"/>
            <Button Grid.Column="3" Grid.Row="4" Content="Save" Margin="21,1,135,4" Background="#FF189B0C" Click="SaveButton_Click"/>
            <Button Grid.Column="3" Grid.Row="4" Content="Cancel" Margin="122,1,41,4" Background="#FFD76E1E" Click="CancelButton_Click" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
        </Grid>
    </Grid>
</Window>
