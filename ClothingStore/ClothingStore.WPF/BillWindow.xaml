<Window x:Class="ClothingStore.WPF.BillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="720" Width="1000"
        WindowStyle="None"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Border Background="#eff2f7" CornerRadius="30" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--Left Menu-->
            <Grid HorizontalAlignment="Left" Width="200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Margin="20 28 0 35" Style="{StaticResource topButton}">
                    <Icon:PackIconMaterial Height="15" Width="15" Kind="Menu"/>
                </Button>
                <Border Grid.Row="1" Background="#623ed0" CornerRadius="0 50 0 30">
                    <DockPanel>

                        <Border Width="80" Height="80" Padding="3" Background="White" CornerRadius="100"
                    DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="20 -30 0 0">
                            <Ellipse Margin="2,0,-2,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/images/user-icon.png"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>
                        <TextBlock Text="Clothing Store" Foreground="White" FontSize="22" FontWeight="SemiBold"
                        DockPanel.Dock="Top" TextAlignment="Center" Margin="5 25 0 10"/>

                        <!--Menu Seprator-->
                        <Separator Margin="25" DockPanel.Dock="Top" Height="0.8" Background="#7e5fdc"/>
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Top">
                                <Button Style="{StaticResource menuButton}" Click="Dashboard_Clicked">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                        <TextBlock Text="Dashboard"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource menuButton}" Click="Profile_Clicked">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                        <TextBlock Text="Profile"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource menuButton}" Click="Product_Clicked">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                        <TextBlock Text="Products"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource menuButton}" Click="Bill_Clicked">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                        <TextBlock Text="Bills"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource menuButton}" Click="Customer_Clicked">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                        <TextBlock Text="Customers"/>
                                    </StackPanel>
                                </Button>


                            </StackPanel>


                        </StackPanel>
                        <Button Style="{StaticResource menuButton}" VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Margin="15" Click="Button_Logout">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Logout" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Log Out"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

            </Grid>
            <Grid Grid.Column="1" Margin="25,10,25,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid Width="300" HorizontalAlignment="Left">
                    <!--<TextBlock Margin="20 0" VerticalAlignment="Center" Foreground="#b0b9c6" IsHitTestVisible="False" Panel.ZIndex="1" Text=""
                    Visibility="Visible"/>
                    <TextBox x:Name="txtSearch" Style="{StaticResource textboxSearch}"/>
                    <Button Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 15 0" BorderThickness="0" 
                        Click="Search_Clicked">
                        <Button.Background>
                            <SolidColorBrush Color="Transparent"/>
                        </Button.Background>
                        <Button.Content>
                            <Icon:PackIconMaterial Kind="Magnify" Width="15" Height="15" Foreground="#60b9c6"/>
                        </Button.Content>
                    </Button>-->
                </Grid>
                <TextBlock Text="Bills" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0" HorizontalAlignment="Left" Foreground="#121518"/>
                <!--Add Button-->
                <Button Style="{StaticResource addButton}" Click="CreateBillButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Width="11" Height="11" Margin="0 1 8 0"/>
                        <TextBlock Text="Create A New Bill"/>
                    </StackPanel>
                </Button>
                <Separator Grid.Row="3" Margin="0 -1 0 10" Height="1" Background="#dae2ea"/>
                <TextBlock Text="Category" Grid.Row="4" FontSize="13" FontWeight="SemiBold" Margin="0 0 215 0" Foreground="#121518" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <!--<Grid Width="200" HorizontalAlignment="Right" Grid.Row="4">
                    <ComboBox x:Name="Cbo_Category" SelectionChanged="Cbo_Category_SelectionChanged"/>
                </Grid>-->
                <DataGrid x:Name="dgProducts" RowHeaderStyle="{DynamicResource DataGridRowHeaderStyle1}" RowStyle="{DynamicResource DataGridRowStyle1}" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" Style="{DynamicResource DataGridStyle1}" CellStyle="{DynamicResource DataGridCellStyle1}" Margin="0,10,0,10" Grid.Row="5">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn CanUserResize="False" Width="auto">
                            <DataGridCheckBoxColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox/>
                                </DataTemplate>
                            </DataGridCheckBoxColumn.HeaderTemplate>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="Id" Width="auto" IsReadOnly="True" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Customer" Width="*" IsReadOnly="True" Binding="{Binding Customer}"/>
                        <DataGridTextColumn Header="Date" Width="*" IsReadOnly="True" Binding="{Binding Date}"/>
                        <DataGridTextColumn Header="Total Price" Width="auto" IsReadOnly="True" Binding="{Binding TotalPrice}"/>
                        <DataGridTemplateColumn Header="Operations" IsReadOnly="True" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="EditButton_Click" Style="{StaticResource gridEditButton}">
                                            <Icon:PackIconMaterial Kind="Penciloutline" Style="{StaticResource gridButtonIcon}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>



                    </DataGrid.Columns>
                </DataGrid>

            </Grid>


        </Grid>




    </Border>
</Window>
