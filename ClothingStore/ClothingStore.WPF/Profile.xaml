<Window x:Class="ClothingStore.WPF.Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="720" Width="1000"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent">
    <Border Background="#eff2f7" CornerRadius="30" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--Left Menu-->
            <Grid HorizontalAlignment="Left" Width="200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Margin="20 28 0 35" Style="{StaticResource topButton}">
                    <Icon:PackIconMaterial Height="15" Width="15" Kind="Menu"/>
                </Button>
                <Border Grid.Row="1" Background="#623ed0" CornerRadius="0 50 0 30">
                    <DockPanel>

                        <Border Width="80" Height="80" Padding="3" Background="White" CornerRadius="100"
                     DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="20 -30 0 0">
                            <Ellipse Margin="2,0,-2,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/images/user-icon.png"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>
                        <TextBlock Text="Clothing Store" Foreground="White" FontSize="22" FontWeight="SemiBold"
                         DockPanel.Dock="Top" TextAlignment="Center" Margin="5 25 0 10"/>

                        <!--Menu Seprator-->
                        <Separator Margin="25" DockPanel.Dock="Top" Height="0.8" Background="#7e5fdc"/>
                        <StackPanel DockPanel.Dock="Top">
                            <Button Style="{StaticResource menuButton}" Click="Dashboard_Clicked">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Dashboard"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource menuButton}" Click="Profile_Clicked">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Profile"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource menuButton}" Click="Product_Clicked">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Products"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource menuButton}" Click="Bill_Clicked">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Bills"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource menuButton}" Click="Customer_Clicked">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Customers"/>
                                </StackPanel>
                            </Button>


                        </StackPanel>
                        <Button Style="{StaticResource menuButton}" VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Margin="15" Click="Button_Logout">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Logout" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Log Out"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

            </Grid>

            <TextBlock Text="Profile" FontSize="32" FontWeight="SemiBold" Margin="5,103,0,10" HorizontalAlignment="Left" Foreground="#121518" Grid.Column="1"/>
            <Grid Margin="10,165,183,350" Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="119.415"/>
                    <ColumnDefinition Width="30.585"/>
                    <ColumnDefinition Width="47*"/>
                    <ColumnDefinition Width="513*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="label" Content="Change Password" Grid.Column="2" Grid.Row="0"
FontSize="24" HorizontalAlignment="Left" Width="466" Grid.ColumnSpan="2" Margin="21,0,0,0"/>
                <Label x:Name="label1" Margin="2,2,2,2" Content="Old Password" Grid.Column="0"
Grid.Row="1" Grid.ColumnSpan="2"/>
                <PasswordBox x:Name="txtOldPass" Margin="4,4,4,4" Grid.Column="2" Grid.Row="1"
   Grid.ColumnSpan="2"/>
                <Label x:Name="label2" Margin="2,2,2,2" Grid.Column="0" Grid.Row="2" Content="New Password"
Grid.ColumnSpan="2"/>
                <PasswordBox x:Name="txtNewPass" Margin="4,4,4,4" Grid.Column="2" Grid.Row="2"
   Grid.ColumnSpan="2"/>

                <Label x:Name="label3" Margin="2,2,2,2" Content="Confirm Password" Grid.Column="0"
Grid.Row="4" Grid.ColumnSpan="2"/>
                <PasswordBox x:Name="txtCfPass" Margin="4,4,4,4" Grid.Column="2" Grid.Row="4"
  Grid.ColumnSpan="2"/>

            </Grid>
            <Button Grid.Column="1" Content="Save Change" HorizontalAlignment="Left" Margin="486,321,0,0" VerticalAlignment="Top" Height="29" Width="113" Click="Button_Click"/>

        </Grid>





    </Border>
</Window>
